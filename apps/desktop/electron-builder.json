{
  "appId": "com.echo.dictation",
  "productName": "Echo",
  "asar": true,
  "directories": {
    "output": "../../release"
  },
  "files": [
    "out/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../services/api/bundle/index.mjs",
      "to": "api/index.mjs"
    }
  ],
  "mac": {
    "target": [
      "dir"
    ],
    "identity": null
  }
}
