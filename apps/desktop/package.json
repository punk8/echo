{
  "name": "@echo/desktop",
  "version": "0.1.0",
  "description": "Echo desktop dictation app",
  "author": "Echo",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:native && electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "pnpm rebuild:native && electron-builder --mac dir --config electron-builder.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "pnpm rebuild:native && electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native:node": "node -e \"const { dirname } = require('node:path'); const { spawnSync } = require('node:child_process'); const dir = dirname(require.resolve('better-sqlite3/package.json')); const result = spawnSync('npm', ['run', 'install'], { cwd: dir, stdio: 'inherit' }); process.exit(result.status ?? 1);\""
  },
  "dependencies": {
    "@echo/shared": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "better-sqlite3": "^11.8.0",
    "electron-store": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
